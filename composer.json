{
    "name": "coinpay/laravel-integration",
    "description": "laravel-integration-package for https://coinpay.finance/en",
    "license": "MIT",
    "authors": [
        {
            "name": "CoinPay",
            "email": "support@coinpay.finance"
        }
    ],
    "autoload": {
        "psr-4": {
            "Coinpay\\Finance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coinpay\\Finance\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coinpay\\Finance\\CoinPayServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
